@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="ae-auth">
    <div class="container">
        <div class="ae-auth-card">
            <div class="ae-auth-top">
                <h1>Acceso de administrador</h1>
                <p>Ingrese con su cuenta autorizada de AeroAndes.</p>
            </div>
            <div class="ae-auth-body">
                <form method="post" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">Correo electrónico</label>
                        <input asp-for="Correo" class="form-control form-control-lg" maxlength="150"
                               autocomplete="username" autofocus placeholder="nombre@aeroandes.example" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                        <input asp-for="Password" class="form-control form-control-lg" maxlength="100"
                               autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-ae btn-lg">Ingresar</button>
                    </div>
                </form>
                <p class="ae-auth-note mb-0">
                    Solo personal autorizado. Tras 5 intentos fallidos la cuenta se bloquea 5 minutos
                    y la sesión se cierra sola después de 20 minutos sin actividad.
                </p>
            </div>
        </div>
    </div>
</section>
