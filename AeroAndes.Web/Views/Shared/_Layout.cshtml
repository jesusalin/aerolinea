<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – AeroAndes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="ae-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand ae-brand" asp-controller="Home" asp-action="Index">AeroAndes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Vuelos" asp-action="Buscar">Vuelos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="destinos">Destinos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contacto" asp-action="Index">Ayuda</a></li>
                    </ul>
                    <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Panel</a></li>
                            <li class="nav-item ae-nav-user px-lg-2">@User.Identity?.Name</li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Cuenta" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="nav-link ae-linkbtn">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="ae-footer">
        <div class="container py-4 small">
            <strong>AeroAndes</strong> · Proyecto académico de Seguridad de la Información. Aerolínea ficticia; todos los datos son de prueba.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
