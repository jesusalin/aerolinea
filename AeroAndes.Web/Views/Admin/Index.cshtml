@model AdminResumen
@{
    ViewData["Title"] = "Panel de administración";
}

<div class="container py-4">
    <h1 class="h3 mb-3">Panel de administración</h1>
    <p>Sesión iniciada como <strong>@User.Identity?.Name</strong>.</p>
    <p>Vuelos: @Model.Vuelos · Reservas: @Model.Reservas</p>

    <h2 class="h5 mt-4">Últimos mensajes de contacto</h2>
    <table class="table table-sm">
        <thead><tr><th>Fecha</th><th>Nombre</th><th>Asunto</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Contactos)
            {
                <tr><td>@c.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td><td>@c.Nombre</td><td>@c.Asunto</td><td>@c.Estado</td></tr>
            }
        </tbody>
    </table>
</div>